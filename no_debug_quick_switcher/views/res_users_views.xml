<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Preferences dialog (My Profile) -->
    <record id="view_users_form_preferences_debug_mode" model="ir.ui.view">
        <field name="name">res.users.preferences.debug.mode</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Debug Mode Quick Switcher">
                    <field name="x_debug_default_mode"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Full user form (admins) -->
    <record id="view_users_form_debug_mode" model="ir.ui.view">
        <field name="name">res.users.form.debug.mode</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Debug Mode Quick Switcher">
                    <field name="x_debug_default_mode"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
