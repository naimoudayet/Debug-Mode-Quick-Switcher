<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        v16 / v17 Dropdown API: toggler content goes in a named `toggler` slot,
        menu items are direct children (default slot). This differs from v18+
        where the Dropdown takes a default-slot toggler and a named `content`
        slot. See ODOO_GUIDELINES notes if propagating to newer branches.
    -->
    <t t-name="no_debug_quick_switcher.DebugModeSwitcher" owl="1">
        <div class="o_no_debug_switcher" t-att-data-mode="state.current.value">
            <Dropdown class="'o_no_debug_switcher__dropdown'"
                      menuClass="'o_no_debug_switcher__menu'"
                      togglerClass="'o_no_debug_switcher__btn btn btn-link p-0'"
                      title="tooltipText">
                <t t-set-slot="toggler">
                    <span class="o_no_debug_switcher__badge"
                          t-att-style="'background-color: ' + state.current.color">
                        <t t-esc="state.current.short"/>
                    </span>
                </t>

                <div class="dropdown-header py-1 px-3 small text-muted">Debug Mode</div>
                <t t-foreach="modes" t-as="mode" t-key="mode.value">
                    <DropdownItem onSelected="() => this.onSelectMode(mode.value)"
                                  class="mode.value === state.current.value ? 'active' : ''">
                        <span class="d-inline-block o_no_debug_switcher__swatch me-2"
                              t-att-style="'background-color: ' + mode.color"/>
                        <span t-esc="mode.label"/>
                        <t t-if="mode.value === state.current.value">
                            <i class="fa fa-check ms-2 text-success"/>
                        </t>
                    </DropdownItem>
                </t>
                <div role="separator" class="dropdown-divider"/>
                <DropdownItem onSelected="() => this.onCopyDebugUrl()">
                    <i class="fa fa-link me-2 text-muted"/>Copy debug URL
                </DropdownItem>
                <div class="px-3 pt-1 pb-2 small text-muted o_no_debug_switcher__hotkey-hint">
                    <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>D</kbd> cycles &#160;·&#160;
                    <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>A</kbd> jumps to Assets
                </div>
            </Dropdown>
        </div>
    </t>

</templates>
