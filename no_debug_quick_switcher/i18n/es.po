msgstr "Conmutador Rápido de Modo Depuración"

#. module: no_debug_quick_switcher
#: model:ir.module.module,summary:no_debug_quick_switcher.module_meta_information
msgid ""
"One-click navbar switcher for Odoo's 5 debug modes — Off, Dev, Assets,"
" Tests, Assets+Tests — with per-user default, hotkey, and mobile suppo"
"rt"
msgstr ""
"Conmutador de barra de navegación de un clic para los 5 modos de depur"
"ación de Odoo — Desactivado, Dev, Assets, Tests, Assets+Tests — con pr"
"eferencia por usuario, atajo de teclado y soporte móvil"

