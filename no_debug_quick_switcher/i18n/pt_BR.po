msgstr "Alternador Rápido de Modo Depuração"

#. module: no_debug_quick_switcher
#: model:ir.module.module,summary:no_debug_quick_switcher.module_meta_information
msgid ""
"One-click navbar switcher for Odoo's 5 debug modes — Off, Dev, Assets,"
" Tests, Assets+Tests — with per-user default, hotkey, and mobile suppo"
"rt"
msgstr ""
"Alternador da barra de navegação de um clique para os 5 modos de depur"
"ação do Odoo — Desligado, Dev, Assets, Tests, Assets+Tests — com prefe"
"rência por usuário, atalho de teclado e suporte móvel"

