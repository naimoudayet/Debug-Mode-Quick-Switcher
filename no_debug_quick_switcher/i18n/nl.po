#. module: no_debug_quick_switcher
#. odoo-javascript
#: code:addons/no_debug_quick_switcher/static/src/systray/debug_switcher.js:0
#, python-format
msgid "Current debug mode: %s"
msgstr "Huidige debug-modus: %s"

#. module: no_debug_quick_switcher
#: model:ir.module.module,description:no_debug_quick_switcher.module_meta_information
msgid ""
"Debug Mode Quick Switcher replaces the URL-typing dance. A navbar drop"
"down shows the current debug mode with a colour badge and lets you jum"
"p to any of the 5 modes in one click. Per-user default is remembered a"
"cross sessions on your res.users record. Ctrl+Shift+D cycles modes; Ct"
"rl+Shift+A jumps to Assets. Mobile-ready. A page-edge stripe in heavy "
"modes (Assets / Tests) keeps you from forgetting you're slowing the ap"
"p down. Global 'disable in production' master switch keeps the module "
"dormant on prod databases."
msgstr ""
"Snelschakelaar Debug-Modus vervangt het URL-typen. Een dropdown in de "
"navigatiebalk toont de huidige debug-modus met een gekleurde badge en "
"laat u in één klik naar een van de 5 modi springen. Voorkeur per gebru"
"iker wordt over sessies onthouden op uw res.users-record. Ctrl+Shift+D"
" doorloopt modi; Ctrl+Shift+A springt naar Assets. Mobielvriendelijk. "
"Een streep aan de paginarand in zware modi (Assets / Tests) voorkomt d"
"at u vergeet dat u de app vertraagt. Een globale 'uitschakelen in prod"
"uctie' hoofdschakelaar houdt de module inactief op productiedatabases."

#. module: no_debug_quick_switcher
#: model:ir.module.module,shortdesc:no_debug_quick_switcher.module_meta_information
msgid "Debug Mode Quick Switcher"
msgstr "Snelschakelaar Debug-Modus"

#. module: no_debug_quick_switcher
#: model:ir.module.module,summary:no_debug_quick_switcher.module_meta_information
msgid ""
"One-click navbar switcher for Odoo's 5 debug modes — Off, Dev, Assets,"
" Tests, Assets+Tests — with per-user default, hotkey, and mobile suppo"
"rt"
msgstr ""
"Eén-klik navigatiebalk-schakelaar voor Odoo's 5 debug-modi — Uit, Dev,"
" Assets, Tests, Assets+Tests — met voorkeur per gebruiker, sneltoets e"
"n mobiele ondersteuning"

